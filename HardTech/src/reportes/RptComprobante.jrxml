<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="RptComprobante" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="53496b9f-11a1-4d36-93ba-df5b75a606ab">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="cnnSistema"/>
	<parameter name="idventa" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT dbsistema.venta.tipo_comprobante,
	dbsistema.venta.serie_comprobante,
	dbsistema.venta.num_comprobante,
	dbsistema.venta.fecha,
	dbsistema.venta.impuesto,
	dbsistema.venta.total,
	dbsistema.persona.nombre,
	dbsistema.persona.tipo_documento,
	dbsistema.persona.num_documento,
	dbsistema.persona.direccion,
	dbsistema.persona.telefono,
	dbsistema.persona.email,
	dbsistema.usuario.nombre,
	dbsistema.articulo.codigo,
	dbsistema.articulo.nombre,
	dbsistema.detalle_venta.cantidad,
	dbsistema.detalle_venta.precio,
	dbsistema.detalle_venta.descuento
FROM dbsistema.detalle_venta
	INNER JOIN dbsistema.articulo ON 
	 dbsistema.detalle_venta.articulo_id = dbsistema.articulo.id 
	INNER JOIN dbsistema.venta ON 
	 dbsistema.detalle_venta.venta_id = dbsistema.venta.id 
	INNER JOIN dbsistema.persona ON 
	 dbsistema.venta.persona_id = dbsistema.persona.id 
	INNER JOIN dbsistema.usuario ON 
	 dbsistema.venta.usuario_id = dbsistema.usuario.id
WHERE dbsistema.venta.id= $P{idventa}]]>
	</queryString>
