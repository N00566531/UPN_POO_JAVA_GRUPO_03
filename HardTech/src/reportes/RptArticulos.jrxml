	<queryString>
		<![CDATA[SELECT 
    articulo.id,
    articulo.codigo,
    articulo.nombre,
    categoria.nombre AS categoria,
    articulo.precio_venta,
    articulo.stock,
    articulo.activo
FROM articulo
INNER JOIN categoria ON articulo.categoria_id = categoria.id
WHERE articulo.activo = 1
ORDER BY articulo.nombre ASC]]>
	</queryString>
